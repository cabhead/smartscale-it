{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "slug": {
      "type": "string"
    },
    "category": {
      "type": "string"
    },
    "tags": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "publishedAt": {
      "type": "string",
      "format": "date-time"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "draft": {
      "default": false,
      "type": "boolean"
    },
    "featured": {
      "default": false,
      "type": "boolean"
    },
    "author": {
      "default": "smartscale Redaktion",
      "type": "string"
    },
    "seoTitle": {
      "type": "string"
    },
    "seoDescription": {
      "type": "string"
    },
    "coverImage": {
      "type": "string"
    },
    "reviewedBy": {
      "type": "string"
    },
    "sources": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "affiliateUrl": {
      "type": "string",
      "format": "uri"
    },
    "affiliateLinks": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string",
            "format": "uri"
          },
          "label": {
            "type": "string"
          },
          "tool": {
            "type": "string"
          }
        },
        "required": [
          "url",
          "label"
        ]
      }
    },
    "faq": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "question": {
            "type": "string"
          },
          "answer": {
            "type": "string"
          }
        },
        "required": [
          "question",
          "answer"
        ]
      }
    },
    "toolName": {
      "type": "string"
    },
    "officialUrl": {
      "type": "string",
      "format": "uri"
    },
    "pricing": {
      "default": "paid",
      "type": "string",
      "enum": [
        "free",
        "paid",
        "freemium"
      ]
    },
    "priceNote": {
      "type": "string"
    },
    "freePlan": {
      "default": false,
      "type": "boolean"
    },
    "rating": {
      "type": "number",
      "minimum": 0,
      "maximum": 5
    },
    "pros": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "cons": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "bestFor": {
      "type": "string"
    },
    "alternatives": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "affiliateAvailable": {
      "default": false,
      "type": "boolean"
    },
    "$schema": {
      "type": "string"
    }
  },
  "required": [
    "title",
    "description",
    "publishedAt",
    "toolName",
    "officialUrl"
  ]
}