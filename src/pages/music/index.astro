---
const pageTitle = "saint.x37 — Musik aus dem echten Leben"
const pageDesc = "Emotionale Musik mit Texten aus echten Lebenserfahrungen. Rap, R&B, Pop — mit Hilfe von KI zum Leben erweckt."
---

<html lang="de">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDesc} />
    <link rel="canonical" href="https://smartscale.it/music/" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDesc} />
    <meta property="og:type" content="website" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <style>
      * { margin: 0; padding: 0; box-sizing: border-box; }
      body {
        background: #0a0a0f;
        color: #e5e5e5;
        font-family: system-ui, -apple-system, sans-serif;
        min-height: 100vh;
        display: flex;
        flex-direction: column;
        align-items: center;
        padding: 1.5rem 1rem 2rem;
      }
      .container {
        width: 100%;
        max-width: 480px;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 1.5rem;
      }
      .avatar-wrap {
        margin-top: 1rem;
        width: 80vw;
        max-width: 540px;
        aspect-ratio: 16 / 10;
        border-radius: 24px;
        overflow: hidden;
        border: 1px solid #2a2a4a;
        box-shadow: 0 4px 60px rgba(107, 127, 255, 0.12);
        position: relative;
      }
      .avatar-video {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
      }
      .avatar-fade {
        position: absolute;
        inset: 0;
        pointer-events: none;
        background: linear-gradient(
          to bottom,
          transparent 50%,
          rgba(10, 10, 15, 0.3) 70%,
          rgba(10, 10, 15, 0.7) 85%,
          rgba(10, 10, 15, 1) 100%
        );
      }
      .name {
        font-size: 1.5rem;
        font-weight: 700;
        letter-spacing: 0.05em;
        text-transform: uppercase;
      }
      .tagline {
        font-size: 0.875rem;
        color: #888;
        text-align: center;
        line-height: 1.6;
      }
      .tagline .genres {
        display: block;
        margin-top: 0.5rem;
        font-size: 0.8rem;
        color: #666;
        letter-spacing: 0.05em;
      }
      .social-links {
        display: flex;
        gap: 1rem;
        flex-wrap: wrap;
        justify-content: center;
      }
      .social-link {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 48px;
        height: 48px;
        border-radius: 50%;
        background: #1a1a2e;
        border: 1px solid #2a2a4a;
        color: #e5e5e5;
        text-decoration: none;
        transition: all 0.2s;
      }
      .social-link:hover {
        background: #2a2a4a;
        border-color: #3a3a6a;
        transform: translateY(-2px);
      }
      .social-link svg {
        width: 20px;
        height: 20px;
        fill: currentColor;
      }
      .section-title {
        font-size: 0.75rem;
        text-transform: uppercase;
        letter-spacing: 0.15em;
        color: #666;
        margin-top: 0.5rem;
      }
      .streaming-links {
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
        width: 100%;
      }
      .streaming-link {
        display: flex;
        align-items: center;
        gap: 1rem;
        padding: 0.875rem 1.25rem;
        background: #1a1a2e;
        border: 1px solid #2a2a4a;
        border-radius: 12px;
        color: #e5e5e5;
        text-decoration: none;
        transition: all 0.2s;
        font-size: 0.9375rem;
        font-weight: 500;
      }
      .streaming-link:hover {
        background: #2a2a4a;
        border-color: #3a3a6a;
        transform: translateY(-1px);
      }
      .streaming-link svg {
        width: 22px;
        height: 22px;
        fill: currentColor;
        flex-shrink: 0;
      }
      .streaming-link .name-text {
        flex: 1;
      }
      .streaming-link .arrow {
        color: #555;
        font-size: 0.875rem;
      }
      .footer {
        margin-top: 2rem;
        font-size: 0.75rem;
        color: #444;
        text-align: center;
      }
      .footer a {
        color: #555;
        text-decoration: none;
      }
      .footer a:hover {
        color: #777;
      }
    </style>
  </head>
