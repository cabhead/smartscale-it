      <!-- Avatar Video -->
      <div class="avatar-wrap">
        <video class="avatar-video" autoplay muted loop playsinline>
          <source src="https://ugc.production.linktr.ee/0b4d0fce-5bbb-45f3-85d3-aee01815e061_19.mp4" type="video/mp4">
        </video>
        <div class="avatar-fade"></div>
