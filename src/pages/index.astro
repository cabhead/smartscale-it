---
import { siteConfig } from '../config/site'
import { getCollection } from 'astro:content'

// Get latest content for homepage
const tools = (await getCollection('tools')).filter(t => !t.data.draft).slice(0, 6)
const news = (await getCollection('news')).filter(n => !n.data.draft).slice(0, 6)
const vergleiche = (await getCollection('vergleiche')).filter(v => !v.data.draft).slice(0, 3)

const pageTitle = `${siteConfig.name} – ${siteConfig.tagline}`
const pageDesc = siteConfig.description
---

<html lang="de">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDesc} />
    <link rel="canonical" href={siteConfig.url} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDesc} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={siteConfig.url} />
    <meta property="og:locale" content="de_DE" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="alternate" type="application/rss+xml" title="smartscale.it RSS" href="/rss.xml" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <script is:inline>
      ;(function(){const s=localStorage.getItem('theme');const d=window.matchMedia('(prefers-color-scheme: dark)').matches;if(s==='dark'||(!s&&d))document.documentElement.classList.add('dark')})()
    </script>
  </head>
  <body class="bg-zinc-50 dark:bg-zinc-950 text-zinc-900 dark:text-zinc-100 min-h-screen flex flex-col antialiased">
    <!-- Header -->
    <header class="border-b border-zinc-200 dark:border-zinc-800 sticky top-0 bg-white/80 dark:bg-zinc-950/80 backdrop-blur-md z-50">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex items-center justify-between h-16">
          <a href="/" class="text-xl font-bold tracking-tight">
            <span class="text-blue-600 dark:text-blue-400">smart</span>scale<span class="text-blue-600 dark:text-blue-400">.it</span>
          </a>
          <nav class="hidden md:flex items-center gap-6 text-sm font-medium">
            {siteConfig.nav.map(item => (
              <a href={item.href} class="text-zinc-600 dark:text-zinc-400 hover:text-zinc-900 dark:hover:text-zinc-100 transition-colors">
                {item.label}
              </a>
            ))}
          </nav>
        </div>
      </div>
    </header>

    <main class="flex-1">
      <!-- Hero -->
      <section class="py-20 sm:py-28">
        <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
          <h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold tracking-tight mb-6">
            KI-Tools, Agenten &<br />
            <span class="text-blue-600 dark:text-blue-400">Automatisierung</span>
          </h1>
          <p class="text-lg sm:text-xl text-zinc-600 dark:text-zinc-400 max-w-2xl mx-auto mb-10">
            Unabhängige Tests, Vergleiche und Erklärungen — für Selbstständige, KMU und alle die mit KI arbeiten wollen.
          </p>
          <div class="flex flex-wrap justify-center gap-4">
            <a href="/tools/" class="inline-flex items-center px-6 py-3 bg-blue-600 hover:bg-blue-700 text-white font-semibold rounded-xl transition-colors">
              Tools entdecken
            </a>
            <a href="/vergleiche/" class="inline-flex items-center px-6 py-3 bg-zinc-200 dark:bg-zinc-800 hover:bg-zinc-300 dark:hover:bg-zinc-700 font-semibold rounded-xl transition-colors">
              Vergleiche ansehen
            </a>
          </div>
        </div>
      </section>

      <!-- Latest News -->
      {news.length > 0 && (
        <section class="py-16 border-t border-zinc-200 dark:border-zinc-800">
          <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex items-center justify-between mb-8">
              <h2 class="text-2xl font-bold">Aktuelle News</h2>
              <a href="/news/" class="text-blue-600 dark:text-blue-400 hover:underline text-sm font-medium">
                Alle News →
              </a>
            </div>
            <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
              {news.map(item => (
                <a href={`/news/${item.slug || item.id}`} class="group block p-6 rounded-2xl border border-zinc-200 dark:border-zinc-800 hover:border-blue-300 dark:hover:border-blue-700 transition-colors">
                  <time class="text-xs text-zinc-500 dark:text-zinc-500">
                    {new Date(item.data.publishedAt).toLocaleDateString('de-DE', { day: 'numeric', month: 'long', year: 'numeric' })}
                  </time>
                  <h3 class="text-lg font-semibold mt-2 group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors">
                    {item.data.title}
                  </h3>
                  <p class="text-sm text-zinc-600 dark:text-zinc-400 mt-2 line-clamp-2">
                    {item.data.description}
                  </p>
                </a>
              ))}
            </div>
          </div>
        </section>
      )}

      <!-- Featured Tools -->
      {tools.length > 0 && (
        <section class="py-16 border-t border-zinc-200 dark:border-zinc-800">
          <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex items-center justify-between mb-8">
              <h2 class="text-2xl font-bold">Tool-Bewertungen</h2>
              <a href="/tools/" class="text-blue-600 dark:text-blue-400 hover:underline text-sm font-medium">
                Alle Tools →
              </a>
            </div>
            <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
              {tools.map(tool => (
                <a href={`/tools/${tool.slug || tool.id}`} class="group block p-6 rounded-2xl border border-zinc-200 dark:border-zinc-800 hover:border-blue-300 dark:hover:border-blue-700 transition-colors">
                  <div class="flex items-center justify-between mb-3">
                    <h3 class="text-lg font-semibold group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors">
                      {tool.data.toolName}
                    </h3>
                    {tool.data.rating && (
                      <span class="text-sm font-mono text-amber-500">
                        {'★'.repeat(Math.round(tool.data.rating))}{'☆'.repeat(5 - Math.round(tool.data.rating))}
                      </span>
                    )}
                  </div>
                  <p class="text-sm text-zinc-600 dark:text-zinc-400 line-clamp-2">
                    {tool.data.description}
                  </p>
                  {tool.data.pricing && (
                    <span class="inline-block mt-3 text-xs font-medium px-2.5 py-1 rounded-full bg-zinc-100 dark:bg-zinc-800 text-zinc-600 dark:text-zinc-400">
                      {tool.data.pricing === 'freemium' ? 'Freemium' : tool.data.pricing === 'free' ? 'Kostenlos' : 'Kostenpflichtig'}
                    </span>
                  )}
                </a>
              ))}
            </div>
          </div>
        </section>
      )}
    </main>

    <!-- Footer -->
    <footer class="border-t border-zinc-200 dark:border-zinc-800 py-12">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-8">
          <div>
            <a href="/" class="text-lg font-bold">
              <span class="text-blue-600 dark:text-blue-400">smart</span>scale<span class="text-blue-600 dark:text-blue-400">.it</span>
            </a>
            <p class="text-sm text-zinc-500 dark:text-zinc-500 mt-3">
              Unabhängige KI-Tool-Tests, Vergleiche und News.
            </p>
          </div>
          <div>
            <h4 class="font-semibold mb-3">Inhalte</h4>
            <ul class="space-y-2 text-sm text-zinc-600 dark:text-zinc-400">
              <li><a href="/tools/" class="hover:text-zinc-900 dark:hover:text-zinc-100">Tools</a></li>
              <li><a href="/vergleiche/" class="hover:text-zinc-900 dark:hover:text-zinc-100">Vergleiche</a></li>
              <li><a href="/news/" class="hover:text-zinc-900 dark:hover:text-zinc-100">News</a></li>
              <li><a href="/tutorials/" class="hover:text-zinc-900 dark:hover:text-zinc-100">Tutorials</a></li>
            </ul>
          </div>
          <div>
            <h4 class="font-semibold mb-3">Wissen</h4>
            <ul class="space-y-2 text-sm text-zinc-600 dark:text-zinc-400">
              <li><a href="/agents/" class="hover:text-zinc-900 dark:hover:text-zinc-100">KI-Agenten</a></li>
              <li><a href="/lexikon/" class="hover:text-zinc-900 dark:hover:text-zinc-100">Lexikon</a></li>
              <li><a href="/automation/" class="hover:text-zinc-900 dark:hover:text-zinc-100">Automatisierung</a></li>
            </ul>
          </div>
          <div>
            <h4 class="font-semibold mb-3">Rechtliches</h4>
            <ul class="space-y-2 text-sm text-zinc-600 dark:text-zinc-400">
              <li><a href="/about/" class="hover:text-zinc-900 dark:hover:text-zinc-100">Über uns</a></li>
              <li><a href="/datenschutz/" class="hover:text-zinc-900 dark:hover:text-zinc-100">Datenschutz</a></li>
              <li><a href="/impressum/" class="hover:text-zinc-900 dark:hover:text-zinc-100">Impressum</a></li>
            </ul>
          </div>
        </div>
        <div class="border-t border-zinc-200 dark:border-zinc-800 mt-8 pt-8 text-center text-sm text-zinc-500 dark:text-zinc-500">
          © {new Date().getFullYear()} smartscale.it — Alle Rechte vorbehalten.
        </div>
      </div>
    </footer>

    <script defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon='{"token": "0d1834ac2f474b3cb78583e74a89a2b2"}'></script>
  </body>
</html>
